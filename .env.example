# Copy to .env.local — never commit real keys

# Used in production
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CURATOR_ADMIN_PASSWORD=

# Optional
# COINBASE_CDP_API_KEY=
# NEXT_PUBLIC_SAFE_API_KEY=
# Dedicated HMAC secret for curator_session (required in production)
# CURATOR_SESSION_SECRET=
# Shared login rate limits across Vercel isolates (Upstash / Vercel KV REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Bump to invalidate all sessions without changing the password
# CURATOR_SESSION_VERSION=1
# Number of proxies in front of the app (Cloudflare + Vercel = 2). Required for
# per-IP login rate limiting; without it x-forwarded-for is treated as spoofable
# and every unattributable client shares one login bucket.
# CURATOR_TRUSTED_PROXY_HOPS=
# MORPHO_API_URL=

# Optional vault address overrides
# NEXT_PUBLIC_VAULT_USDC_V2=
# NEXT_PUBLIC_VAULT_WETH_V2=
# NEXT_PUBLIC_VAULT_CBBTC_V2=
# NEXT_PUBLIC_VAULT_USDC_V2_FRONTIER=
# NEXT_PUBLIC_VAULT_CBBTC_V2_TEST=
# NEXT_PUBLIC_VAULT_USDC_V2_TEST=
# NEXT_PUBLIC_VAULT_USDC_PRIME_WRAPPER=
# NEXT_PUBLIC_VAULT_USDC_FRONTIER_WRAPPER=
# NEXT_PUBLIC_VAULT_WETH_PRIME_WRAPPER=
# NEXT_PUBLIC_VAULT_CBBTC_PRIME_WRAPPER=
# NEXT_PUBLIC_VAULT_USDC_TEST_WRAPPER=
