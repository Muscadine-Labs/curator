# Copy to `.env` or `.env.local` — never commit real keys

# Used in production
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Optional, server only: Morpho REST API key (private.api.morpho.org, higher rate limits)
# MORPHO_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3001
CURATOR_ADMIN_PASSWORD=

# Optional
# Safe Transaction Service. Also the source for /curator/gates whitelist history
# (executed Curator and Allocator calls to the gate). https://developer.safe.global
# NEXT_PUBLIC_SAFE_API_KEY=
# Dedicated HMAC secret for curator_session (optional — login password is used if unset)
# CURATOR_SESSION_SECRET=
# Bump to invalidate all sessions without changing the password
# CURATOR_SESSION_VERSION=1
# Number of proxies in front of the app (Cloudflare + Vercel = 2). Required for
# per-IP login rate limiting; without it x-forwarded-for is treated as spoofable
# and every unattributable client shares one login bucket.
# CURATOR_TRUSTED_PROXY_HOPS=
